<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مواقيت الصلاة — السويس"
            android:textColor="#D8B15A"
            android:textStyle="bold"
            android:textSize="15sp"
            android:fontFamily="sans"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widgetDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#AFC2C8"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- Subtle breathing space -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Prayer information -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/prayerRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:minHeight="34dp"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:alpha="0.10"
            android:background="#FFFFFF" />

        <LinearLayout
            android:id="@+id/prayerRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:minHeight="34dp"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <LinearLayout
            android:id="@+id/karahRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:minHeight="30dp"
            android:gravity="center_vertical"
            android:layout_marginTop="5dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

    </LinearLayout>

    <!-- Next prayer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="7dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/widgetNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2" />

    </LinearLayout>

</LinearLayout>